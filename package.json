{
  "name": "browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "browser-agent": "./bin/browser-agent.js"
  },
  "scripts": {
    "check": "node --check bin/browser-agent.js && node --check src/cli.js && node --check src/capture.js",
    "test": "node --test",
    "test:integration": "BROWSER_AGENT_INTEGRATION=1 node --test test/capture.integration.test.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@playwright/cli": "0.1.17",
    "playwright": "1.62.0"
  }
}
